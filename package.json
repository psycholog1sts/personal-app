{
  "name": "rlsproof",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "rlsproof": "./src/cli.js",
    "guardian": "./src/cli.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "i18n:check": "node scripts/validate-locales.js",
    "prebuild": "npm run i18n:check",
    "build": "next build",
    "verify:site": "node scripts/verify-static-site.mjs",
    "test": "node --test test/*.test.js",
    "test:core": "node --test test/core.test.js",
    "scan:self": "node src/cli.js scan . --native-only --json"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
